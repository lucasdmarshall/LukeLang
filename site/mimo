#!/usr/bin/env bash
# mimo — LukeLang toolchain installer + package manager.
#
#   curl -fsSL https://lukelang.org/mimo | bash
#   mimo inject lukelang
#   mimo init
#   mimo forge greeter
#   mimo forge http
#   mimo run
#
# Install root:  $MIMO_HOME (default ~/.mimo)
# Channel URL:   $MIMO_DIST  (default https://lukelang.org/dist/mimo)
# Registry URL:  $MIMO_REGISTRY (default https://packages.lukelang.org/index.json)
set -euo pipefail

MIMO_VERSION="0.3.0"
MIMO_HOME="${MIMO_HOME:-${HOME}/.mimo}"
MIMO_DIST="${MIMO_DIST:-https://lukelang.org/dist/mimo}"
MIMO_BIN="${MIMO_HOME}/bin"
MIMO_TOOLCHAINS="${MIMO_HOME}/toolchains"
MIMO_CACHE="${MIMO_HOME}/cache"
MIMO_REGISTRY="${MIMO_REGISTRY:-https://packages.lukelang.org/index.json}"

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

die() { printf 'mimo: %s\n' "$*" >&2; exit 1; }
info() { printf 'mimo: %s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

download() {
  local url="$1" dest="$2"
  if have curl; then
    curl -fsSL --retry 3 --retry-delay 1 "$url" -o "$dest"
  elif have wget; then
    wget -q -O "$dest" "$url"
  else
    die "need curl or wget to download $url"
  fi
}

sha256_of() {
  local f="$1"
  if have sha256sum; then
    sha256sum "$f" | awk '{print $1}'
  elif have shasum; then
    shasum -a 256 "$f" | awk '{print $1}'
  elif have openssl; then
    openssl dgst -sha256 "$f" | awk '{print $NF}'
  else
    die "need sha256sum, shasum, or openssl"
  fi
}

# Host target triple used in release artifacts.
detect_target() {
  local os arch
  os="$(uname -s 2>/dev/null | tr '[:upper:]' '[:lower:]')"
  arch="$(uname -m 2>/dev/null)"

  case "$os" in
    linux*)  os=linux ;;
    darwin*) os=darwin ;;
    msys*|mingw*|cygwin*) os=windows ;;
    *) die "unsupported OS: $(uname -s)" ;;
  esac

  case "$arch" in
    x86_64|amd64)      arch=x86_64 ;;
    i386|i486|i586|i686) arch=i686 ;;
    aarch64|arm64)     arch=arm64 ;;
    armv7l|armv7|armhf|armv6l) arch=armv7 ;;
    *) die "unsupported arch: $arch" ;;
  esac

  # Normalize to artifact names.
  case "$os-$arch" in
    linux-x86_64)   echo "linux-x86_64" ;;
    linux-i686)     echo "linux-i686" ;;
    linux-arm64)    echo "linux-aarch64" ;;
    linux-armv7)    echo "linux-armv7" ;;
    darwin-x86_64)  echo "darwin-x86_64" ;;
    darwin-arm64)   echo "darwin-arm64" ;;
    windows-x86_64) echo "windows-x86_64" ;;
    windows-i686)   echo "windows-i686" ;;
    windows-arm64)  echo "windows-arm64" ;;
    *) die "no artifact mapping for $os-$arch" ;;
  esac
}

ensure_dirs() {
  mkdir -p "$MIMO_BIN" "$MIMO_TOOLCHAINS" "$MIMO_CACHE"
}

install_self() {
  ensure_dirs
  local self dest
  self="${BASH_SOURCE[0]:-$0}"
  if [ -f "$self" ] && grep -q 'inject LukeLang' "$self" 2>/dev/null; then
    cp "$self" "${MIMO_BIN}/mimo"
  else
    # Running via curl | bash — re-fetch the canonical script.
    download "${MIMO_DIST}/mimo" "${MIMO_BIN}/mimo"
  fi
  chmod +x "${MIMO_BIN}/mimo"
  info "installed mimo ${MIMO_VERSION} → ${MIMO_BIN}/mimo"
}

# ---------------------------------------------------------------------------
# channel / inject
# ---------------------------------------------------------------------------

channel_url() {
  local channel="${1:-stable}"
  echo "${MIMO_DIST}/channel/${channel}.json"
}

fetch_channel() {
  local channel="${1:-stable}"
  local dest="${MIMO_CACHE}/${channel}.json"
  download "$(channel_url "$channel")" "$dest"
  echo "$dest"
}

json_get() {
  # Minimal JSON string/object field reader without jq dependency.
  # Usage: json_get <file> <dotted.path>
  # Supports flat keys and one-level nested objects used by our manifest.
  local file="$1" path="$2"
  if have python3; then
    python3 - "$file" "$path" <<'PY'
import json, sys
data = json.load(open(sys.argv[1], encoding="utf-8"))
cur = data
for part in sys.argv[2].split("."):
    if cur is None:
        break
    if isinstance(cur, dict):
        cur = cur.get(part)
    else:
        cur = None
        break
if cur is None:
    sys.exit(1)
if isinstance(cur, (dict, list)):
    print(json.dumps(cur))
else:
    print(cur)
PY
    return
  fi
  die "python3 required to read channel manifests"
}

parse_spec() {
  # lukelang / lukelang@0.3.0 / lukelang@latest → name version
  local spec="$1"
  local name version
  case "$spec" in
    *@*)
      name="${spec%@*}"
      version="${spec#*@}"
      ;;
    *)
      name="$spec"
      version="latest"
      ;;
  esac
  printf '%s %s\n' "$name" "$version"
}

artifact_ext() {
  case "$1" in
    windows-*) echo "zip" ;;
    *) echo "tar.gz" ;;
  esac
}

inject_tool() {
  local spec="$1"
  local channel="${2:-stable}"
  read -r name want_ver <<<"$(parse_spec "$spec")"
  [ "$name" = "lukelang" ] || [ "$name" = "luke" ] || die "unknown tool '$name' (try: lukelang)"

  ensure_dirs
  local manifest target version url sha256 ext archive stage root link_name
  manifest="$(fetch_channel "$channel")"
  target="$(detect_target)"

  if [ "$want_ver" = "latest" ]; then
    version="$(json_get "$manifest" version)" || die "channel missing version"
  else
    version="$want_ver"
  fi

  # Confirm the target exists in the channel (when asking for latest).
  if [ "$want_ver" = "latest" ]; then
    json_get "$manifest" "targets.${target}.url" >/dev/null 2>&1 \
      || die "no ${target} build in channel ${channel} yet — see https://lukelang.org/download/"
    sha256="$(json_get "$manifest" "targets.${target}.sha256" 2>/dev/null || true)"
  else
    sha256=""
  fi

  ext="$(artifact_ext "$target")"
  # Always resolve against MIMO_DIST so mirrors / local smoke tests work.
  url="${MIMO_DIST}/lukelang/${version}/luke-${target}.${ext}"

  archive="${MIMO_CACHE}/luke-${target}-${version}.${ext}"
  info "inject lukelang@${version} (${target})"
  download "$url" "$archive"

  if [ -n "${sha256:-}" ]; then
    local got
    got="$(sha256_of "$archive")"
    [ "$got" = "$sha256" ] || die "checksum mismatch for ${archive}: got ${got}, want ${sha256}"
    info "sha256 ok"
  fi

  root="${MIMO_TOOLCHAINS}/lukelang-${version}"
  rm -rf "$root"
  mkdir -p "$root"
  stage="${MIMO_CACHE}/extract-$$"
  rm -rf "$stage"
  mkdir -p "$stage"

  case "$ext" in
    tar.gz) tar -xzf "$archive" -C "$stage" ;;
    zip)
      if have unzip; then unzip -q "$archive" -d "$stage"
      elif have python3; then python3 - "$archive" "$stage" <<'PY'
import sys, zipfile
zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])
PY
      else die "need unzip or python3 to extract zip"
      fi
      ;;
  esac

  # Archive layout: luke or luke.exe at top level, optional README.
  if [ -f "${stage}/luke" ]; then
    mv "${stage}/luke" "${root}/luke"
    chmod +x "${root}/luke"
    link_name=luke
  elif [ -f "${stage}/luke.exe" ]; then
    mv "${stage}/luke.exe" "${root}/luke.exe"
    link_name=luke.exe
  else
    # Sometimes wrapped in a directory.
    local found
    found="$(find "$stage" -maxdepth 3 \( -name luke -o -name luke.exe \) -type f | head -1)"
    [ -n "$found" ] || die "archive missing luke binary"
    if [[ "$found" == *.exe ]]; then
      mv "$found" "${root}/luke.exe"
      link_name=luke.exe
    else
      mv "$found" "${root}/luke"
      chmod +x "${root}/luke"
      link_name=luke
    fi
  fi
  rm -rf "$stage"

  ln -sfn "${root}/${link_name}" "${MIMO_BIN}/luke"
  # Also keep a non-.exe alias name on Windows-friendly shells.
  if [ "$link_name" = "luke.exe" ]; then
    ln -sfn "${root}/luke.exe" "${MIMO_BIN}/luke.exe" 2>/dev/null || cp "${root}/luke.exe" "${MIMO_BIN}/luke.exe"
  fi

  printf '%s\n' "$version" > "${MIMO_HOME}/current-lukelang"
  info "lukelang ${version} ready"
  info "binary: ${MIMO_BIN}/luke"
  path_hint
}

path_hint() {
  case ":${PATH}:" in
    *":${MIMO_BIN}:"*) info "PATH already contains ${MIMO_BIN}" ;;
    *)
      info "add to your shell profile:"
      printf '\n  export PATH="%s:$PATH"\n\n' "$MIMO_BIN"
      ;;
  esac
}
list_tools() {
  ensure_dirs
  echo "mimo home: ${MIMO_HOME}"
  echo "registry:  ${MIMO_REGISTRY}"
  echo "target:    $(detect_target)"
  echo
  echo "toolchains:"
  local any=0
  if [ -d "$MIMO_TOOLCHAINS" ]; then
    local d
    for d in "$MIMO_TOOLCHAINS"/lukelang-*; do
      [ -d "$d" ] || continue
      any=1
      local ver base
      base="$(basename "$d")"
      ver="${base#lukelang-}"
      if [ -f "${MIMO_HOME}/current-lukelang" ] && [ "$(cat "${MIMO_HOME}/current-lukelang")" = "$ver" ]; then
        echo "  lukelang ${ver}  (active)"
      else
        echo "  lukelang ${ver}"
      fi
    done
  fi
  [ "$any" = 1 ] || echo "  (none — mimo inject lukelang)"
  if [ -x "${MIMO_BIN}/mimo" ]; then
    echo "  mimo     (at ${MIMO_BIN}/mimo)"
  fi
  echo
  echo "packages (./luke_modules):"
  if [ -d luke_modules ]; then
    local p found=0
    for p in luke_modules/*/; do
      [ -d "$p" ] || continue
      found=1
      echo "  luke/$(basename "$p")"
    done
    [ "$found" = 1 ] || echo "  (none — mimo forge <name>)"
  else
    echo "  (none — mimo forge <name>)"
  fi
  if [ -f luke.json ] && have python3; then
    echo
    echo "project: luke.json"
    python3 - <<'PY' || true
import json
try:
    d = json.load(open("luke.json", encoding="utf-8"))
except Exception:
    raise SystemExit
for k, v in sorted((d.get("dependencies") or {}).items()):
    print(f"  {k}: {v}")
PY
  fi
}

eject_tool() {
  local name="${1:-lukelang}"
  case "$name" in
    lukelang|luke) ;;
    *) die "unknown tool '$name' (did you mean: mimo remove <package>?)" ;;
  esac
  rm -f "${MIMO_BIN}/luke" "${MIMO_BIN}/luke.exe"
  rm -f "${MIMO_HOME}/current-lukelang"
  rm -rf "${MIMO_TOOLCHAINS}"/lukelang-*
  info "ejected lukelang"
}

doctor() {
  echo "mimo ${MIMO_VERSION}"
  echo "home     ${MIMO_HOME}"
  echo "dist     ${MIMO_DIST}"
  echo "registry ${MIMO_REGISTRY}"
  echo "target   $(detect_target)"
  echo "shell    ${SHELL:-unknown}"
  have curl && echo "curl     $(command -v curl)" || echo "curl     missing"
  have wget && echo "wget     $(command -v wget)" || true
  have python3 && echo "python3  $(command -v python3)" || echo "python3  missing (needed for manifests)"
  if [ -x "${MIMO_BIN}/luke" ] || [ -x "${MIMO_BIN}/luke.exe" ]; then
    echo "luke     present"
    "${MIMO_BIN}/luke" 2>&1 | head -3 || true
  elif have luke; then
    echo "luke     $(command -v luke)"
  else
    echo "luke     not injected"
  fi
  case ":${PATH}:" in
    *":${MIMO_BIN}:"*) echo "PATH     ok" ;;
    *) echo "PATH     missing ${MIMO_BIN}" ;;
  esac
}

find_luke() {
  if [ -x "${MIMO_BIN}/luke" ]; then
    echo "${MIMO_BIN}/luke"
  elif [ -x "${MIMO_BIN}/luke.exe" ]; then
    echo "${MIMO_BIN}/luke.exe"
  elif have luke; then
    command -v luke
  else
    return 1
  fi
}

fetch_registry() {
  ensure_dirs
  local dest="${MIMO_CACHE}/packages-index.json"
  if download "$MIMO_REGISTRY" "$dest" 2>/dev/null; then
    echo "$dest"
    return
  fi
  # Prefer branded host when DNS/TLS are live; fall back to the main site path.
  if [ "$MIMO_REGISTRY" != "https://packages.lukelang.org/index.json" ] && \
     download "https://packages.lukelang.org/index.json" "$dest" 2>/dev/null; then
    echo "$dest"
    return
  fi
  if [ "$MIMO_REGISTRY" != "https://lukelang.org/packages/index.json" ]; then
    info "trying https://lukelang.org/packages/index.json"
    download "https://lukelang.org/packages/index.json" "$dest"
    echo "$dest"
    return
  fi
  die "cannot fetch package registry"
}

pkg_init() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    name="$(basename "$PWD")"
  fi
  if [ -f luke.json ]; then
    die "luke.json already exists"
  fi
  mkdir -p luke_modules
  cat > luke.json <<EOF
{
  "name": "${name}",
  "version": "0.1.0",
  "main": "main.lk",
  "dependencies": {}
}
EOF
  if [ ! -f main.lk ] && [ ! -f main.luke ]; then
    cat > main.lk <<'EOF'
print("Hello from LukeLang")
EOF
  fi
  info "initialized project '${name}'"
  info "  luke.json"
  info "  main.lk"
  info "  luke_modules/"
  info "next: mimo forge greeter   or   mimo run"
}

pkg_add() {
  local spec="${1:?usage: mimo forge <package>[@version]}"
  read -r name want_ver <<<"$(parse_spec "$spec")"
  case "$name" in
    postgresql) name=postgres ;;
  esac

  local index entry kind
  index="$(fetch_registry)"
  entry="$(json_get "$index" "packages.${name}" 2>/dev/null)" \
    || die "package '${name}' not in registry — see ${MIMO_REGISTRY}"

  kind="$(printf '%s' "$entry" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("kind",""))')"

  case "$kind" in
    builtin)
      local imp ver
      imp="$(printf '%s' "$entry" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("import",""))')"
      ver="$(printf '%s' "$entry" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("version","0.3.0"))')"
      info "'${name}' ships with LukeLang"
      info "  add to your source:  import ${imp}"
      pkg_record_dep "$name" "builtin:${ver}"
      return 0
      ;;
    planned)
      die "'${name}' is planned but not published yet — see lukelang.org/packages"
      ;;
  esac

  local version url sha archive dest reg_base tarball
  version="$(printf '%s' "$entry" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("version",""))')"
  [ -n "$version" ] || die "registry entry for ${name} missing version"
  if [ "$want_ver" != "latest" ]; then
    version="$want_ver"
  fi
  sha="$(printf '%s' "$entry" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("archive_sha256") or "")')"
  tarball="$(printf '%s' "$entry" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("tarball") or "")')"
  reg_base="${MIMO_REGISTRY%/index.json}"
  if [ -n "$tarball" ]; then
    url="${reg_base}/${tarball}"
  else
    url="${reg_base}/${name}/${version}/${name}.tar.gz"
  fi

  ensure_dirs
  archive="${MIMO_CACHE}/${name}-${version}.tar.gz"
  info "forge luke/${name}@${version}"
  if ! download "$url" "$archive" 2>/dev/null; then
    local fb
    fb="$(printf '%s' "$entry" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("url_fallback") or d.get("url") or "")')"
    [ -n "$fb" ] && [ "$fb" != "$url" ] || die "download failed: $url"
    info "trying fallback URL"
    download "$fb" "$archive"
  fi
  if [ -n "$sha" ]; then
    local got
    got="$(sha256_of "$archive")"
    [ "$got" = "$sha" ] || die "checksum mismatch: got ${got}, want ${sha}"
    info "sha256 ok"
  fi

  mkdir -p luke_modules
  dest="luke_modules/${name}"
  rm -rf "$dest"
  tar -xzf "$archive" -C luke_modules
  if [ ! -f "${dest}/luke.pkg" ] && [ ! -f "${dest}/main.luke" ] && [ ! -f "${dest}/main.lk" ]; then
    die "archive did not produce luke_modules/${name}"
  fi
  pkg_record_dep "$name" "$version"
  pkg_write_lock
  info "installed luke/${name} → ${dest}"
  info "  import luke/${name}"
}

pkg_record_dep() {
  local name="$1" version="$2"
  if [ ! -f luke.json ]; then
    pkg_init "$(basename "$PWD")"
  fi
  python3 - "$name" "$version" <<'PY'
import json, sys
name, version = sys.argv[1], sys.argv[2]
path = "luke.json"
data = json.load(open(path, encoding="utf-8"))
deps = data.setdefault("dependencies", {})
deps[name] = version
open(path, "w", encoding="utf-8").write(json.dumps(data, indent=2) + "\n")
PY
}

pkg_write_lock() {
  python3 - <<'PY'
import hashlib
from pathlib import Path
root = Path("luke_modules")
lines = ["# luke.lock — written by mimo", "lock_version=1", ""]
if root.is_dir():
    for d in sorted(p for p in root.iterdir() if p.is_dir()):
        blob = b""
        for part in ("luke.pkg", "main.luke", "main.lk"):
            f = d / part
            if f.is_file():
                blob += f.read_bytes()
        ver = "0.0.0"
        pkg = d / "luke.pkg"
        if pkg.is_file():
            for line in pkg.read_text(encoding="utf-8").splitlines():
                if line.startswith("version="):
                    ver = line.split("=", 1)[1].strip()
        digest = hashlib.sha256(blob).hexdigest() if blob else ""
        lines.append(f"package {d.name} version {ver} sha256 {digest}")
Path("luke.lock").write_text("\n".join(lines) + "\n", encoding="utf-8")
PY
  info "wrote luke.lock"
}

pkg_remove() {
  local name="${1:?usage: mimo remove <package>}"
  case "$name" in
    lukelang|luke)
      eject_tool lukelang
      return
      ;;
  esac
  if [ -d "luke_modules/${name}" ]; then
    rm -rf "luke_modules/${name}"
    info "removed luke_modules/${name}"
  else
    info "no luke_modules/${name}"
  fi
  if [ -f luke.json ]; then
    python3 - "$name" <<'PY'
import json, sys
name = sys.argv[1]
data = json.load(open("luke.json", encoding="utf-8"))
deps = data.get("dependencies") or {}
if name in deps:
    del deps[name]
    data["dependencies"] = deps
    open("luke.json", "w", encoding="utf-8").write(json.dumps(data, indent=2) + "\n")
PY
  fi
  [ -d luke_modules ] && pkg_write_lock || true
}

pkg_run() {
  local file="${1:-}"
  local luke_bin
  luke_bin="$(find_luke)" || die "luke not found — run: mimo inject lukelang"
  if [ -z "$file" ]; then
    if [ -f luke.json ]; then
      file="$(python3 -c 'import json; print(json.load(open("luke.json")).get("main","main.lk"))')"
    elif [ -f main.lk ]; then
      file=main.lk
    elif [ -f main.luke ]; then
      file=main.luke
    else
      die "no main.lk — pass a file: mimo run app.lk"
    fi
  fi
  [ -f "$file" ] || die "file not found: $file"
  mkdir -p .mimo/run
  local out=".mimo/run/app"
  info "BUILD ${file}"
  "$luke_bin" BUILD "$file" -o "$out"
  info "run ${out}"
  "$out"
}

usage() {
  cat <<EOF
mimo ${MIMO_VERSION} — LukeLang toolchain + packages

Toolchain:
  mimo inject lukelang[@version]   Install the compiler
  mimo update lukelang             Update to channel latest
  mimo eject lukelang              Remove the compiler
  mimo doctor                      Diagnose install / PATH

Packages:
  mimo init [name]                 Create luke.json + main.lk
  mimo forge <package>[@version]   Install from the package registry
  mimo remove <package>            Remove from luke_modules/
  mimo run [file]                  Build and run the project
  mimo list                        Toolchains + packages

Environment:
  MIMO_HOME       ~/.mimo
  MIMO_DIST       https://lukelang.org/dist/mimo
  MIMO_REGISTRY   https://packages.lukelang.org/index.json

Bootstrap:
  curl -fsSL https://lukelang.org/mimo | bash
EOF
}

main() {
  local cmd="${1:-}"
  if [ -z "$cmd" ]; then
    install_self
    inject_tool lukelang stable
    return
  fi
  shift || true
  case "$cmd" in
    inject)
      [ $# -ge 1 ] || die "usage: mimo inject lukelang[@version]"
      inject_tool "$1" "${2:-stable}"
      ;;
    update)
      inject_tool "${1:-lukelang}" stable
      ;;
    list|ls)
      list_tools
      ;;
    eject|uninstall)
      eject_tool "${1:-lukelang}"
      ;;
    init)
      pkg_init "${1:-}"
      ;;
    forge|add|install)
      [ $# -ge 1 ] || die "usage: mimo forge <package>"
      pkg_add "$1"
      ;;
    remove|rm)
      [ $# -ge 1 ] || die "usage: mimo remove <package>"
      pkg_remove "$1"
      ;;
    run)
      pkg_run "${1:-}"
      ;;
    doctor)
      doctor
      ;;
    self-install|setup)
      install_self
      path_hint
      ;;
    help|-h|--help)
      usage
      ;;
    version|--version|-V)
      echo "mimo ${MIMO_VERSION}"
      ;;
    *)
      die "unknown command '$cmd' (try: mimo help)"
      ;;
  esac
}

main "$@"
